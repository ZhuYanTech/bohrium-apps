# PLIP 玻尔 App — 自定义 Web 应用镜像（Streamlit，草稿，未验证）
# 用途：玻尔“自定义 Web 应用”型 App。Streamlit 界面已在 apps/plip/app_streamlit.py
# 实现并本地验证过（首页 200、/_stcore/health ok），本镜像把它跑起来：
#   streamlit run app_streamlit.py --server.port=50001 --server.address=0.0.0.0
# 玻尔文档要求 Web 应用绑定 0.0.0.0，端口自定义；部署时在服务配置里填 50001。
# 费用注意：自定义 Web 应用由开发者承担实例费用，可选免费机型、按访问自动休眠/唤醒。
# 构建：在有 Docker 的机器上：
#   cd apps/plip && docker build -f Dockerfile.web -t plip-bohrium-web:1.0 .
# 本文件是草稿：尚未做 docker build 验证；不要直接替换 Dockerfile。
FROM python:3.12-slim

LABEL org.opencontainers.image.title="PLIP 蛋白-配体相互作用分析（玻尔 App，Streamlit）"
LABEL org.opencontainers.image.description="PLIP 3.0.1, GPLv2. Upload PDB / PDB ID, output interaction table + Chinese report."
LABEL org.opencontainers.image.source="https://github.com/pharmai/plip"

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# 系统依赖 + SSH 组件（玻尔要求管理节点可用；任务提交本身不受影响）
RUN sed -i 's/archive.ubuntu.com/mirrors.aliyun.com/g' /etc/apt/sources.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        libgomp1 \
        openssh-server \
        supervisor \
        net-tools \
        curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-plip.txt ./
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple -r requirements-plip.txt

COPY requirements.txt ./
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple -r requirements.txt

COPY run_plip.py app_streamlit.py ./

RUN useradd -m -u 10001 plipuser && chown -R plipuser:plipuser /app
USER plipuser

EXPOSE 50001

CMD ["streamlit", "run", "app_streamlit.py", "--server.port=50001", "--server.address=0.0.0.0"]
